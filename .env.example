# Copy this file to `.env.local` and fill in real values.
# These two values are safe to expose in the browser (publishable / anon key).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Mapbox public token. Get one at https://account.mapbox.com/access-tokens/
# Restrict by URL in the Mapbox dashboard before shipping to production.
VITE_MAPBOX_TOKEN=pk.eyJxxxxxxxxxxxxxxxxxxxxxxxx

# Mapbox STYLE used by all four maps (/project, /buy/:slug, /property/:id,
# /schools). Leave unset to keep the stock dark map. To use a style you
# edited in Mapbox Studio, paste its "Style URL" here:
#   Studio -> your style -> Share -> Style URL
# VITE_* is inlined at BUILD time, so changing this needs a redeploy.
VITE_MAPBOX_STYLE=mapbox://styles/<account>/<styleId>

# Mapbox SECRET token (sk.*). DO NOT use VITE_ prefix — must stay server-side.
# Used by the Mapbox MCP and any server/edge code that needs admin scopes.
MAPBOX_ACCESS_TOKEN=sk.eyJxxxxxxxxxxxxxxxxxxxxxxxx
